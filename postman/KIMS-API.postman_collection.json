{
  "info": {
    "name": "KIMS API v1",
    "description": "Mobile/API client collection for KIMS, served under /api on the same app as the admin panel. Admin panel (/admin) is session-based Blade and not covered here. See ARCHITECTURE.md for the full auth/authorization model.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/customer/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"01012345678\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('customer_token', json.token);",
                  "    pm.environment.set('token', json.token);",
                  "    pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff Login - Cashier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/staff/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cashier@kims.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('cashier_token', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff Login - Barista",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/staff/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"barista@kims.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('barista_token', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (revoke current token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/me"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List Branches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.length) pm.environment.set('branch_id', json.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Branch",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/branches/{{branch_id}}"
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/categories"
          }
        },
        {
          "name": "List Products (by branch)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/products?branch_id={{branch_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.length) pm.environment.set('product_id', json.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Product",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/products/{{product_id}}?branch_id={{branch_id}}"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Start Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/cart",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": {{branch_id}},\n  \"order_type\": \"grab_go\"\n}"
            }
          }
        },
        {
          "name": "Show Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/cart"
          }
        },
        {
          "name": "Add Cart Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/cart/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{product_id}},\n  \"quantity\": 1,\n  \"option_ids\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const items = json.data.items;",
                  "    if (items && items.length) pm.environment.set('cart_item_id', items[items.length - 1].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/cart/items/{{cart_item_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2,\n  \"option_ids\": []\n}"
            }
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/cart/items/{{cart_item_id}}"
          }
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/cart/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_note\": \"No sugar please\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('order_id', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/orders"
          }
        },
        {
          "name": "Show Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/orders/{{order_id}}"
          }
        }
      ]
    },
    {
      "name": "Loyalty",
      "item": [
        {
          "name": "Show Loyalty Account",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/loyalty"
          }
        },
        {
          "name": "List Loyalty Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/api/loyalty/transactions"
          }
        }
      ]
    },
    {
      "name": "Cashier",
      "item": [
        {
          "name": "Identify Customer by QR/Barcode",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashier_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/cashier/identify-customer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{customer_code}}\"\n}"
            }
          }
        },
        {
          "name": "Verify Invoice",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashier_token}}" }],
            "url": "{{base_url}}/api/cashier/invoices/{{invoice_number}}"
          }
        },
        {
          "name": "Award Loyalty Points",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashier_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/cashier/loyalty/award",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{customer_code}}\",\n  \"invoice_number\": \"{{invoice_number}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Barista",
      "item": [
        {
          "name": "List Branch Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{barista_token}}" }],
            "url": "{{base_url}}/api/barista/orders?status=confirmed"
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{barista_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/barista/orders/{{order_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"preparing\"\n}"
            }
          }
        }
      ]
    }
  ]
}
